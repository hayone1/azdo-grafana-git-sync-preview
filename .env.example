# Copy to .env (git-ignored) and fill in. Used by npm run e2e:up and npm run test:e2e.

# Azure DevOps organization and project for the test repository.
AZDO_URL="https://dev.azure.com/<org>/"
AZDO_PAT="<PAT, see CONTRIBUTING.md for the scopes>"
AZDO_PROJECT="<project>"

# Grafana checks against the local stack from e2e/docker-compose.yml. Remove to skip them.
GRAFANA_URL="http://localhost:3000"
GRAFANA_USER="admin"
GRAFANA_PASSWORD="admin"
GIT_PROXY_URL="http://git-proxy:8080/grafana-git-sync-e2e.git"
